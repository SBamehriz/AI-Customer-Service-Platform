{
  "name": "unified-customer-service-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Source available unified customer service platform. One inbox across web, email, WhatsApp, Instagram, SMS and voice, with grounded AI assistance and live call coaching.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.widget.config.ts",
    "build:app": "vite build",
    "build:widget": "vite build --config vite.widget.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=low && pip-audit -r backend/requirements.txt"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
