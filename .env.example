# Unified Customer Service Platform, configuration
#
# Every value here is optional for local development. With an empty file the
# app runs on SQLite, generates a development signing key, and starts with no
# LLM provider. Copy this to .env and fill in what you need.
#
# Full reference in docs/configuration.md

# Required in production.
# Without a stable value one is generated per process, so sessions break on
# every restart and more than one worker rejects every token.
# Generate one with openssl rand -hex 32
SECRET_KEY=

# Database.
# The default is a SQLite file at backend/data/ucsp.db.
# For PostgreSQL, pip install asyncpg then set
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ucsp
# DATABASE_URL=

# AI provider. One of none, openai, anthropic, gemini.
# openai also covers Groq, Together, OpenRouter, Mistral, vLLM, LM Studio and
# Ollama. Point LLM_BASE_URL at them.
# With none, the platform still answers from knowledge base retrieval.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional. Adds semantic retrieval alongside BM25. Vectors are cached on the
# article row, so there is still no vector database to run.
# For openai use text-embedding-3-small, for gemini use text-embedding-004.
EMBEDDING_MODEL=

# URLs.
# PUBLIC_URL has to match the origin providers actually call. Twilio signs the
# exact URL, and this is what builds the webhook addresses shown in settings.
PUBLIC_URL=http://localhost:8000

# Comma separated, or a JSON array.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# The embeddable widget runs on sites you do not control, so its public
# endpoints accept any origin. They are scoped by workspace public key and can
# only create or read a single conversation. Set false if you do not use it.
WIDGET_ALLOW_ANY_ORIGIN=true

# Behind a reverse proxy, set this to the address the proxy connects from so
# uvicorn trusts its X-Forwarded-For header. Without it every request looks
# like it came from the proxy, which makes the per address rate limit throttle
# all of your visitors at once. Defaults to 127.0.0.1.
# FORWARDED_ALLOW_IPS=

# Behaviour.
DEBUG=false
ACCESS_TOKEN_TTL_MINUTES=720

# How long to wait on a provider before giving up and falling back to
# retrieval on its own.
LLM_TIMEOUT_SECONDS=30

# How often the database is copied into backend/data/backups/. The newest
# fourteen are kept. Set 0 to turn the timer off, for instance when something
# outside already backs the volume up.
BACKUP_INTERVAL_HOURS=24

# Loads the sample workspace into an empty database, so you can look around
# without setting anything up. Leave it off for real use. The demo accounts
# all share one password and that password is published in the README.
SEED_DEMO_DATA=false

# Channels.
# Channel credentials are per workspace and live in the database, not here.
# Connect them under Settings, Channels, which also shows the webhook URL to
# paste into each provider. See docs/channels.md

# Ceilings on the routes anyone can reach without signing in. The defaults suit
# a small business install and most people never touch them. Set one to 0 to
# turn that ceiling off, which is only sensible when a reverse proxy already
# does the job. See docs/configuration.md
# RATE_LIMIT_SIGN_IN_PER_ADDRESS=60
# RATE_LIMIT_SIGN_IN_PER_ACCOUNT=10
# RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=300
# RATE_LIMIT_REGISTRATIONS=10
# RATE_LIMIT_REGISTRATIONS_WINDOW_SECONDS=3600

# Build time only, read by Vite rather than by the backend.
# Where the frontend calls the API. Leave it empty for the same origin it was
# served from, which is what the single process and Docker setups want. Set it
# only when the frontend is hosted somewhere other than the backend.
# VITE_API_URL=

# Where the Source links on the landing page and the setup guide point. Set
# this if you host the code somewhere other than the default.
# VITE_REPO_URL=
